# Node.js 24 LTS. Nunca versionar .env ou .data.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATA_DIR=.data
RETENTION_DAYS=30
# HTTPS obrigatório fora do ambiente local. Ative atrás de proxy confiável.
NODE_ENV=development
TRUST_PROXY=false
# Número confirmado institucionalmente, apenas dígitos; vazio desativa.
WHATSAPP_NUMBER=
WHATSAPP_CONFIRMED=false
# Integrações externas intencionalmente desativadas neste MVP.
